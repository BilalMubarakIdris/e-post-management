{
  "name": "web-based-epost-management-system",
  "version": "1.0.0",
  "description": "Web-Based E-Post Management System for managing organizational correspondence",
  "main": "server.js",
  "scripts": {
    "dev": "node -e \"require('fs').existsSync('./src/public/css/style.css')||require('fs').writeFileSync('./src/public/css/style.css','')\" && nodemon server.js",
    "start": "node server.js",
    "build:css": "node -e \"require('fs').copyFileSync('./src/public/css/style.css.bak','./src/public/css/style.css')\"",
    "build": "npm run build:css",
    "seed:admin": "node src/scripts/seedAdmin.js"
  },
  "keywords": [
    "epost",
    "correspondence",
    "management",
    "express",
    "mongodb",
    "ejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "method-override": "^3.0.0",
    "moment": "^2.30.1",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "nodemon": "^3.1.4",
    "tailwindcss": "^4.0.0"
  }
}
