<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-3xl font-bold text-gray-800">Manage Departments</h1>
        <p class="text-gray-600">Organizational departments</p>
    </div>
    <a href="/departments/add" class="bg-blue-900 text-white px-4 py-2 rounded hover:bg-blue-800">
        <i class="fas fa-plus mr-2"></i> Add Department
    </a>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            <% if (departments.length > 0) { %>
                <% departments.forEach(dept => { %>
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= dept.name %></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= dept.code %></td>
                        <td class="px-6 py-4 text-sm text-gray-900"><%= dept.description || 'N/A' %></td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 py-1 text-xs rounded-full <%= dept.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                <%= dept.isActive ? 'Active' : 'Inactive' %>
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <a href="/departments/edit/<%= dept._id %>" class="text-blue-600 hover:text-blue-900 mr-3">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <form action="/departments/delete/<%= dept._id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Are you sure?')">
                                <button type="submit" class="text-red-600 hover:text-red-900">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="px-6 py-4 text-center text-gray-500">No departments found</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>
