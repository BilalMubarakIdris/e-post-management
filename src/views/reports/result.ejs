<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-3xl font-bold text-gray-800">Report Results</h1>
        <p class="text-gray-600"><%= correspondence.length %> record(s) found</p>
    </div>
    <div class="space-x-2">
        <button onclick="window.print()" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700">
            <i class="fas fa-print mr-2"></i> Print
        </button>
        <a href="/reports" class="bg-blue-900 text-white px-4 py-2 rounded hover:bg-blue-800">
            <i class="fas fa-arrow-left mr-2"></i> Back to Reports
        </a>
    </div>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tracking No</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Department</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Priority</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            <% if (correspondence.length > 0) { %>
                <% correspondence.forEach(corr => { %>
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-blue-600"><%= corr.trackingNumber %></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= corr.type %></td>
                        <td class="px-6 py-4 text-sm text-gray-900"><%= corr.subject %></td>
                        <td class="px-6 py-4 text-sm text-gray-900"><%= corr.department ? corr.department.name : 'N/A' %></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= corr.status %></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= corr.priority %></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= corr.createdAt.toDateString() %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="7" class="px-6 py-4 text-center text-gray-500">No records found</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<style>
@media print {
    nav, aside, button, a { display: none !important; }
    main { padding: 0; }
}
</style>
