<div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">All Correspondence</h1>
    <p class="text-gray-600">View and manage all correspondence</p>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tracking No</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">From/To</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            <% if (correspondence.length > 0) { %>
                <% correspondence.forEach(corr => { %>
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-blue-600"><%= corr.trackingNumber %></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                            <span class="px-2 py-1 text-xs rounded-full <%= corr.type === 'incoming' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
                                <%= corr.type %>
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-900"><%= corr.subject.substring(0, 40) %>...</td>
                        <td class="px-6 py-4 text-sm text-gray-900">
                            <%= corr.type === 'incoming' ? (corr.sender.name || 'N/A') : (corr.recipient.name || 'N/A') %>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 py-1 text-xs rounded-full 
                                <% if (corr.status === 'completed') { %>bg-green-100 text-green-800
                                <% } else if (corr.status === 'pending') { %>bg-yellow-100 text-yellow-800
                                <% } else { %>bg-blue-100 text-blue-800<% } %>">
                                <%= corr.status %>
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <%= corr.createdAt.toDateString() %>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <a href="<%= corr.type === 'incoming' ? '/incoming/view/' + corr._id : '/outgoing/view/' + corr._id %>" class="text-blue-600 hover:text-blue-900 mr-3">
                                <i class="fas fa-eye"></i> View
                            </a>
                            <% if (user.role === 'admin' || user.role === 'registry_officer') { %>
                                <a href="/correspondence/assign/<%= corr._id %>" class="text-green-600 hover:text-green-900 mr-3">
                                    <i class="fas fa-user-plus"></i> Assign
                                </a>
                            <% } %>
                            <a href="/correspondence/forward/<%= corr._id %>" class="text-orange-600 hover:text-orange-900">
                                <i class="fas fa-share"></i> Forward
                            </a>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="7" class="px-6 py-4 text-center text-gray-500">No correspondence found</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>
