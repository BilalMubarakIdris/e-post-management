<div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Assign Correspondence</h1>
    <p class="text-gray-600">Assign <%= correspondence.trackingNumber %> to a user or department</p>
</div>

<div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <div class="mb-4 p-4 bg-gray-50 rounded">
        <p class="font-medium"><%= correspondence.subject %></p>
        <p class="text-sm text-gray-600">Type: <%= correspondence.type %> | Priority: <%= correspondence.priority %></p>
    </div>
    
    <form action="/correspondence/assign/<%= correspondence._id %>" method="POST" class="space-y-6">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Assign to User</label>
            <select name="assignedTo" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Select User (Optional)</option>
                <% users.forEach(u => { %>
                    <option value="<%= u._id %>"><%= u.fullName %> (<%= u.role.replace('_', ' ') %>) <% if(u.department) { %>- <%= u.department.name %><% } %></option>
                <% }) %>
            </select>
        </div>
        
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Assign to Department</label>
            <select name="department" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">Select Department (Optional)</option>
                <% departments.forEach(dept => { %>
                    <option value="<%= dept._id %>"><%= dept.name %></option>
                <% }) %>
            </select>
        </div>
        
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Remarks</label>
            <textarea name="remarks" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></textarea>
        </div>
        
        <div class="flex space-x-4">
            <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700">
                <i class="fas fa-check mr-2"></i> Assign
            </button>
            <a href="/correspondence" class="bg-gray-500 text-white px-6 py-2 rounded hover:bg-gray-600">Cancel</a>
        </div>
    </form>
</div>
