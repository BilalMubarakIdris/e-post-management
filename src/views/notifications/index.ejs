<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-3xl font-bold text-gray-800">Notifications</h1>
        <p class="text-gray-600">All your notifications</p>
    </div>
    <a href="/notifications/read-all" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
        <i class="fas fa-check-double mr-2"></i> Mark All as Read
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <% if (notifications.length > 0) { %>
        <div class="divide-y divide-gray-200">
            <% notifications.forEach(notif => { %>
                <div class="p-4 <%= notif.isRead ? 'bg-white' : 'bg-blue-50' %> hover:bg-gray-50">
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <h3 class="font-semibold text-gray-800"><%= notif.title %></h3>
                            <p class="text-gray-600 mt-1"><%= notif.message %></p>
                            <p class="text-xs text-gray-500 mt-2"><%= notif.createdAt.toLocaleString() %></p>
                        </div>
                        <div class="ml-4">
                            <% if (notif.link) { %>
                                <a href="/notifications/read/<%= notif._id %>" class="text-blue-600 hover:text-blue-800 text-sm">
                                    <i class="fas fa-arrow-right"></i> View
                                </a>
                            <% } else if (!notif.isRead) { %>
                                <a href="/notifications/read/<%= notif._id %>" class="text-green-600 hover:text-green-800 text-sm">
                                    <i class="fas fa-check"></i> Mark Read
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="p-6 text-center text-gray-500">
            <i class="fas fa-bell-slash text-4xl mb-4"></i>
            <p>No notifications</p>
        </div>
    <% } %>
</div>
