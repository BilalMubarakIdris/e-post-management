<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/css/style.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-blue-900 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center py-4">
                <div class="flex items-center space-x-4">
                    <i class="fas fa-envelope-open-text text-2xl"></i>
                    <h1 class="text-xl font-bold">E-Post Management System</h1>
                </div>
                <div class="flex items-center space-x-4">
                    <% if (user) { %>
                        <span class="text-sm">Welcome, <%= user.name %> (<%= user.role.replace('_', ' ').toUpperCase() %>)</span>
                        <a href="/notifications" class="relative">
                            <i class="fas fa-bell"></i>
                        </a>
                        <a href="/auth/logout" class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded text-sm">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <div class="flex">
        <!-- Sidebar -->
        <% if (user) { %>
        <aside class="w-64 bg-white shadow-lg min-h-screen">
            <nav class="mt-4">
                <a href="/dashboard" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-700">
                    <i class="fas fa-tachometer-alt w-6"></i>
                    <span>Dashboard</span>
                </a>
                
                <% if (user.role === 'admin' || user.role === 'registry_officer') { %>
                <a href="/incoming" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-700">
                    <i class="fas fa-inbox w-6"></i>
                    <span>Incoming</span>
                </a>
                <a href="/outgoing" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-700">
                    <i class="fas fa-paper-plane w-6"></i>
                    <span>Outgoing</span>
                </a>
                <% } %>
                
                <a href="/correspondence" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-700">
                    <i class="fas fa-mail-bulk w-6"></i>
                    <span>All Correspondence</span>
                </a>
                
                <% if (user.role === 'admin') { %>
                <a href="/users" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-700">
                    <i class="fas fa-users w-6"></i>
                    <span>Users</span>
                </a>
                <a href="/departments" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-700">
                    <i class="fas fa-building w-6"></i>
                    <span>Departments</span>
                </a>
                <a href="/audit" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-700">
                    <i class="fas fa-history w-6"></i>
                    <span>Audit Logs</span>
                </a>
                <% } %>
                
                <% if (user.role === 'admin' || user.role === 'registry_officer' || user.role === 'management') { %>
                <a href="/reports" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-700">
                    <i class="fas fa-chart-bar w-6"></i>
                    <span>Reports</span>
                </a>
                <% } %>
                
                <a href="/notifications" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-700">
                    <i class="fas fa-bell w-6"></i>
                    <span>Notifications</span>
                </a>
            </nav>
        </aside>
        <% } %>

        <!-- Main Content -->
        <main class="flex-1 p-6">
            <% if (success_msg && success_msg.length > 0) { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                    <%= success_msg %>
                </div>
            <% } %>
            <% if (error_msg && error_msg.length > 0) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                    <%= error_msg %>
                </div>
            <% } %>
            <%- body %>
        </main>
    </div>
</body>
</html>
